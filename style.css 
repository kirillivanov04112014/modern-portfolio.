
/* ==============================
   MODERN PORTFOLIO
   Main stylesheet
================================ */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background: #0b1020;
  color: #f4f5fb;
  font-family: 'DM Sans', sans-serif;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

.accent {
  color: #9b8cff;
}

.gradient-text {
  background: linear-gradient(100deg, #a99aff, #6ed9e8);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* HEADER */

.site-header {
  max-width: 1180px;
  height: 82px;
  margin: auto;
  padding: 0 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 18px;
  font-weight: 700;
}

.logo-mark {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(135deg, #8d7aff, #53c9dc);
  color: #0b1020;
}

.nav {
  display: flex;
  align-items: center;
  gap: 34px;
  color: #aeb4c9;
  font-size: 13px;
}

.nav a:hover {
  color: white;
}

.nav-contact {
  padding: 11px 16px;
  border: 1px solid #343b54;
  border-radius: 9px;
  color: white;
}

.menu-toggle {
  display: none;
}

/* HERO */

.section {
  max-width: 1180px;
  margin: auto;
  padding: 75px 28px;
}

.hero {
  min-height: 660px;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 30px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 10px 14px;
  margin-bottom: 28px;
  border: 1px solid #29314a;
  border-radius: 30px;
  color: #929bb5;
  font-size: 10px;
  letter-spacing: 2px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #61d6a7;
}

.intro {
  margin-bottom: 10px;
  color: #b8bfd2;
  font-size: 17px;
}

.hero h1 {
  margin-bottom: 22px;
  font-size: clamp(48px, 6vw, 76px);
  line-height: 1.04;
  letter-spacing: -4px;
}

.hero-description {
  max-width: 490px;
  color: #a7afc5;
  font-size: 15px;
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 25px;
  margin-top: 32px;
}

.button {
  display: inline-flex;
  align-items: center;
  gap: 18px;
  padding: 15px 19px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 700;
  transition: 0.2s;
}

.button:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 35px #8374ff33;
}

.button-primary {
  background: linear-gradient(110deg, #9582ff, #65cddd);
  color: #0c1221;
}

.text-link {
  color: #c4c9d8;
  font-size: 13px;
}

.hero-meta {
  display: flex;
  gap: 22px;
  margin-top: 55px;
  color: #747f9d;
  font-size: 11px;
}

/* CODE CARD */

.hero-visual {
  position: relative;
  height: 430px;
  display: grid;
  place-items: center;
}

.code-card {
  position: relative;
  z-index: 2;
  width: min(100%, 430px);
  border: 1px solid #333c5a;
  border-radius: 15px;
  background: linear-gradient(145deg, #171e34, #11182a);
  box-shadow: 0 35px 90px #0008;
  transform: rotate(2deg);
}

.code-top,
.code-footer {
  height: 46px;
  padding: 0 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #77819f;
  font-size: 10px;
  border-bottom: 1px solid #29324a;
}

.code-lines {
  padding: 24px 18px;
  color: #d4d9e9;
  font-family: monospace;
  font-size: 12px;
  line-height: 2.1;
}

.code-lines p {
  margin: 0;
}

.purple {
  color: #bd9cff;
}

.green {
  color: #8cddb7;
}

.orange {
  color: #f2bd82;
}

.floating-chip {
  position: absolute;
  z-index: 3;
  padding: 10px 13px;
  border: 1px solid #3a4260;
  border-radius: 10px;
  background: #151d32;
  color: #cbd1e3;
  font-size: 10px;
}

.chip-html {
  top: 66px;
  left: 8px;
}

.chip-css {
  top: 125px;
  right: 0;
}

.chip-js {
  bottom: 60px;
  left: 26px;
}

/* SECTION HEADINGS */

.section-kicker {
  color: #929bb5;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin: 18px 0 38px;
}

.section-heading h2,
.contact-panel h2 {
  font-size: clamp(34px, 4.2vw, 52px);
  line-height: 1.13;
  letter-spacing: -2px;
}

.section-heading > p {
  max-width: 290px;
  color: #929bb2;
  font-size: 13px;
  line-height: 1.8;
}

/* ABOUT */

.about-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 15px;
}

.about-card {
  min-height: 190px;
  padding: 25px;
  border: 1px solid #29324a;
  border-radius: 13px;
  background: linear-gradient(145deg, #151d31, #101728);
}

.card-icon {
  color: #a99aff;
  font-size: 20px;
}

.about-card h3 {
  margin: 25px 0 9px;
  font-size: 17px;
}

.about-card p,
.project-card > p {
  color: #929bb2;
  font-size: 12px;
  line-height: 1.8;
}

/* SKILLS */

.skill-list {
  border-top: 1px solid #2b344d;
}

.skill {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 12px;
  border-bottom: 1px solid #2b344d;
}

.skill-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  font-weight: 700;
}

.html-icon {
  background: #39251f;
  color: #ff986d;
}

.css-icon {
  background: #202d49;
  color: #75baff;
}

.js-icon {
  background: #39341e;
  color: #f4d66e;
}

.git-icon {
  background: #292541;
  color: #b6a4ff;
}

.skill h3 {
  font-size: 14px;
  margin-bottom: 4px;
}

.skill p {
  color: #818ba5;
  font-size: 11px;
}

.skill-level {
  margin-left: auto;
  padding: 6px 10px;
  border: 1px solid #3a365e;
  border-radius: 30px;
  color: #9c91df;
  font-size: 10px;
}

/* PROJECTS */

.projects-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.project-card {
  padding: 14px;
  border: 1px solid #2b344d;
  border-radius: 14px;
  background: #121a2d;
}

.project-art {
  height: 205px;
  display: grid;
  place-items: center;
  position: relative;
  border-radius: 9px;
}

.art-one {
  background: radial-gradient(circle, #4b437e, #202744);
}

.art-two {
  background: radial-gradient(circle, #244d5a, #172c3d);
}

.mini-window {
  width: 210px;
  height: 125px;
  padding: 20px;
  border: 1px solid #a39aff66;
  border-radius: 8px;
  background: #10172b;
  transform: rotate(-4deg);
}

.mini-window b {
  display: block;
  margin-top: 20px;
}

.mini-window small {
  color: #9ca6c1;
}

.plus-symbol {
  color: #8de0e7;
  font-size: 55px;
}

.coming {
  position: absolute;
  bottom: 15px;
  color: #9fcbd0;
  font-size: 9px;
  letter-spacing: 3px;
}

.project-info {
  display: flex;
  justify-content: space-between;
  margin: 19px 4px 9px;
}

.project-type {
  color: #a49be1;
  font-size: 8px;
}

.project-info h3 {
  margin-top: 6px;
  font-size: 18px;
}

.project-number {
  color: #68738f;
}

.project-card > p {
  margin: 0 4px 15px;
}

.tags {
  display: flex;
  gap: 7px;
  margin: 0 4px 17px;
}

.tags span {
  padding: 6px 9px;
  border-radius: 5px;
  background: #222b42;
  color: #b2bad0;
  font-size: 9px;
}

.project-link {
  display: inline-block;
  margin: 0 4px 5px;
  color: #a99aff;
  font-size: 11px;
  font-weight: 700;
}

/* CONTACT */

.contact-panel {
  position: relative;
  overflow: hidden;
  padding: 48px;
  border: 1px solid #383b60;
  border-radius: 17px;
  background: radial-gradient(ellipse at 90% 50%, #3c3b6a, #141c30 75%);
}

.contact-panel h2 {
  margin: 20px 0 13px;
}

.contact-panel > p {
  max-width: 420px;
  margin-bottom: 25px;
  color: #a6afc6;
  font-size: 13px;
  line-height: 1.8;
}

/* FOOTER */

.footer {
  max-width: 1180px;
  margin: auto;
  padding: 25px 28px 35px;
  border-top: 1px solid #252e45;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #77819a;
  font-size: 10px;
}

/* MOBILE */

@media (max-width: 760px) {
  .site-header {
    height: 70px;
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px;
    border: 1px solid #343b54;
    border-radius: 8px;
    background: #151d31;
  }

  .menu-toggle span {
    width: 18px;
    height: 2px;
    background: white;
  }

  .nav {
    display: none;
    position: absolute;
    top: 62px;
    left: 18px;
    right: 18px;
    padding: 18px;
    background: #151d31;
    border: 1px solid #343b54;
    border-radius: 12px;
    flex-direction: column;
    align-items: stretch;
  }

  .nav.open {
    display: flex;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 55px;
  }

  .hero h1 {
    font-size: clamp(47px, 12vw, 68px);
    letter-spacing: -3px;
  }

  .hero-visual {
    height: 360px;
  }

  .section-heading {
    display: block;
  }

  .section-heading > p {
    margin-top: 16px;
  }

  .about-grid,
  .projects-grid {
    grid-template-columns: 1fr;
  }

  .contact-panel {
    padding: 30px 23px;
  }

  .footer {
    gap: 15px;
    flex-wrap: wrap;
  }

  .footer > span {
    order: 3;
    width: 100%;
  }

  .hero-meta {
    flex-wrap: wrap;
    gap: 12px;
  }
}

/* ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
